# Copy to .env and enter a NEW key locally. Never commit .env.
KIMI_API_KEY=replace-with-new-key
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k2.6
# citation-first = one Kimi call + local quote/number validation (low latency).
# independent = a second Kimi entailment call (stricter, slower).
RAG_QA_VERIFICATION_MODE=citation-first
# Start one cancellable backup only when a citation-first response exceeds this delay.
# Set 0 to disable hedging and minimize provider cost.
RAG_QA_HEDGE_DELAY_SECONDS=8

# Optional semantic embedding provider, independent of the Kimi chat key.
# Supports OpenAI-compatible /embeddings, including a local service.
# Without this configuration the explicit offline baseline is TF-IDF + BM25 + RRF.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
RAG_MIN_SIMILARITY=0.30

# Optional speech-to-text for audio and video originals.
# Any OpenAI-compatible /audio/transcriptions service works; the key stays here.
# Optional override: api, local (prepare_asr.py first), or disabled.
RAG_ASR_PROVIDER=
RAG_ASR_BASE_URL=
RAG_ASR_MODEL=
RAG_ASR_API_KEY=
# 1 = transcribe audio/video right after upload, 0 = manual 「开始语音转写」.
RAG_MEDIA_AUTO_TRANSCRIBE=1
# Video frame OCR is opt-in: it costs one vision call per sampled frame.
RAG_VIDEO_FRAME_OCR=0

# OCR for images and scanned PDF pages: vision or local (requirements-ocr.txt).
# Local PDF OCR is automatic by default; configure its page limit in settings.
RAG_OCR_PROVIDER=vision

# ffmpeg is required for video; set an absolute path when it is not on PATH.
RAG_FFMPEG_PATH=

# Deployment-owned data source list; the API never stores its credentials.
RAG_DATA_SOURCES_FILE=

# Optional server deployment. Keep credentials in backend/.env.
RAG_DATABASE_URL=
RAG_WORKER_MODE=embedded
RAG_FILE_STORAGE=local
RAG_S3_ENDPOINT=http://127.0.0.1:9000
RAG_S3_REGION=us-east-1
RAG_S3_BUCKET=rag-originals
RAG_S3_ACCESS_KEY=
RAG_S3_SECRET_KEY=
