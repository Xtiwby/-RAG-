# Copy to .env and enter a NEW key locally. Never commit .env.
KIMI_API_KEY=replace-with-new-key
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k2.6

# Optional semantic embedding provider, independent of the Kimi chat key.
# Supports OpenAI-compatible /embeddings, including a local service.
# Without this configuration the explicit offline baseline is TF-IDF + BM25 + RRF.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
RAG_MIN_SIMILARITY=0.30
