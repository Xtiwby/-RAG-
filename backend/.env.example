# Copy to .env and enter a NEW key locally. Never commit .env.
KIMI_API_KEY=replace-with-new-key
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k2.6

# Optional semantic embedding provider, independent of the Kimi chat key.
# Supports OpenAI-compatible /embeddings, including a local service.
# Without this configuration the explicit offline baseline is TF-IDF + BM25 + RRF.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
RAG_MIN_SIMILARITY=0.30

# Optional server deployment. Keep credentials in backend/.env.
RAG_DATABASE_URL=
RAG_WORKER_MODE=embedded
RAG_FILE_STORAGE=local
RAG_S3_ENDPOINT=http://127.0.0.1:9000
RAG_S3_REGION=us-east-1
RAG_S3_BUCKET=rag-originals
RAG_S3_ACCESS_KEY=
RAG_S3_SECRET_KEY=
